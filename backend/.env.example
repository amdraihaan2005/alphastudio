# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection (PostgreSQL connection string, e.g., Supabase Postgres pooler or direct connection)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Groq & Cohere API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Optional LLM & Embeddings Configuration (Defaults shown below)
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# EMBEDDING_MODEL=embed-english-v3.0
# EMBEDDING_DIMENSIONS=1024
# GET_EMBEDDINGS_RETRIES=5
# GET_EMBEDDINGS_DELAY=5.0
# GET_QUERY_RETRIES=4
# GET_QUERY_DELAY=2.0
# COHERE_MAX_BATCH_SIZE=96
# MAX_CONCURRENT_EMBED_REQUESTS=5
